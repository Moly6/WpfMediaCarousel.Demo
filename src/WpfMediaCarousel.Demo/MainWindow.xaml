<Window x:Class="WpfMediaCarousel.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:carousel="clr-namespace:MediaCarousel.Controls;assembly=WpfMediaCarousel"
        Title="WpfMediaCarousel | Demo"
        Width="1120" Height="760" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0B1020" Foreground="#ECF3FF">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,22">
            <TextBlock Text="WPF MEDIA CAROUSEL" FontSize="13" FontWeight="SemiBold"
                       Foreground="#65D7C1" />
            <TextBlock Text="A carousel for image and video." FontSize="30"
                       FontWeight="Bold" Margin="0,8,0,4" />
            <TextBlock Text="Use the arrows or let the slides advance automatically."
                       FontSize="15" Foreground="#AAB8D0" />
        </StackPanel>

        <Border Grid.Row="1" CornerRadius="18" BorderBrush="#263451"
                BorderThickness="1" Background="#111B2D" Padding="8">
            <carousel:MediaCarouselControl x:Name="CarouselControl"
                ItemsSource="{Binding MediaItems}"
                ImageDuration="0:0:6"
                IsAutoPlay="True"
                IsMuted="True"
                ShowNavigationButtons="True"
                ShowIndicators="True"
                PlaceholderImage="{Binding VideoPlaceholder}"
                PlaceholderFadeDuration="0:0:0.35"
                EnableBlurBackground="True"
                BlurRadius="28"
                BackgroundOverlayOpacity="0.25"
                Background="#111B2D" />
        </Border>

        <Grid Grid.Row="2" Margin="2,18,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Previous" Padding="18,10" Margin="0,0,10,0"
                    Command="{Binding PreviousCommand, ElementName=CarouselControl}" />
            <Button Grid.Column="1" Content="Next" Padding="18,10"
                    Command="{Binding NextCommand, ElementName=CarouselControl}" />
            <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="#AAB8D0"
                       Text="{Binding SelectedIndex, ElementName=CarouselControl, StringFormat=Slide {0}}" />
        </Grid>

        <TextBlock Grid.Row="3" Margin="2,14,2,0" TextWrapping="Wrap"
                   Foreground="#73829C" FontSize="12">
            Image slides are included locally. The Big Buck Bunny video slide uses an online sample and needs an internet connection. Video © Blender Foundation, CC BY 3.0.
        </TextBlock>
    </Grid>
</Window>
